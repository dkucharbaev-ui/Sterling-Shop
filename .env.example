# ==============================================================================
# PSYCHO STARS - ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- Application ---
ENVIRONMENT=production
DEBUG=false
APP_NAME="Psycho Stars"
APP_DOMAIN=store.example.com
API_V1_STR=/api/v1
SECRET_KEY=CHANGE_THIS_TO_A_SUPER_SECRET_RANDOM_KEY_MIN_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Telegram Bot ---
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_USERNAME=PsychoStarsBot
MINI_APP_URL=https://store.example.com
# Telegram IDs of administrators (comma-separated)
ADMIN_IDS=123456789,987654321

# --- Database & Redis ---
POSTGRES_USER=psychouser
POSTGRES_PASSWORD=psychopassword
POSTGRES_DB=psychostars
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://psychouser:psychopassword@db:5432/psychostars

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Payment Gateways ---
# Crypto Pay (@CryptoBot)
CRYPTOBOT_API_TOKEN=1234:AAChangeThisCryptoBotToken
CRYPTOBOT_NETWORK=mainnet # or testnet

# Lava Pay (lava.so / lava.ru)
LAVAPAY_SHOP_ID=your-shop-uuid-here
LAVAPAY_SECRET_KEY=your-lava-secret-key-here
LAVAPAY_ADDITIONAL_KEY=your-additional-key-here

# --- TON & Fragment Fulfillment ---
TON_NETWORK=mainnet # or testnet
# 24-word seed phrase of shop wallet (kept strictly secret!)
TON_WALLET_MNEMONIC="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24"
TON_WALLET_VERSION=v4r2 # v4r2 or v5r1
MIN_TON_BALANCE_ALERT=5.0
CRITICAL_TON_BALANCE_PAUSE=1.0
DRY_RUN_FULFILLMENT=true # Set to false in real production!

# Fallback Reseller API (optional)
RESELLER_API_URL=https://api.mystars.tg/v1
RESELLER_API_KEY=

# --- Pricing & Volatility Shield ---
DEFAULT_MARGIN_PERCENT=15.0
CIRCUIT_BREAKER_PRICE_CHANGE_PERCENT=10.0 # Pause orders if TON swings >10% in 15m
RATES_CACHE_TTL_SECONDS=300
